{% extends 'base.html.twig' %}

{% block title %}Émargement{% endblock %}

{% block body %}

    {# Inclusion du menu de navigation #}
    {% include 'auth/menu.html.twig' %}

    <div class="flex flex-col items-center justify-center min-h-screen bg-gradient-to-br from-[#020024] via-[#1b2a59] to-[#273273] p-2">
        <div class="w-full max-w-screen-xl mt-12 px-5">
            <div class="w-full max-w-[850px] bg-white p-5 rounded-xl shadow-lg text-center mx-auto">
                <h2 style="font-family: 'Roboto'" class="text-2xl font-semibold mb-4 text-[#273273]">Signature de présence</h2>

                {# Si une signature existe en base64, on affiche le message + l'image #}
                {% if signature %}
                    <p class="text-green-700 font-medium mb-4">Vous avez déjà signé ce cours.</p>
                    <img src="{{ signature }}" alt="Signature" class="mx-auto border border-gray-300 rounded-lg shadow-md w-96">
                   <a data-turbo="false" href="{{ path(name = 'app_intervenant_validation_emargement', parameters = {id:cours.id}) }}"><button style="font-family: 'Roboto'"  class="bg-[#F24C27] transform-gpu cursor-pointer will-change-transform disabled: transition-all duration-300 ease-in-out hover:scale-105 font-medium rounded-lg p-3 mt-5 text-[#F2F2F2]">Validation apprenants</button></a>
                {# Sinon, on affiche le canvas et le formulaire pour signer #}
                {% else %}
                    <p class="mb-3 text-sm text-gray-600">Signez dans la zone ci-dessous puis validez :</p>

                    <form method="post">
                        <canvas id="signature-pad" width="400" height="200" class="border-2 border-orange-600 rounded-lg mx-auto mb-4"></canvas>
                        
                        {# Ce champ caché stockera la signature (en base64) avant envoi #}
                        <input type="hidden" name="signature" id="signature">

                        <div class="flex justify-center space-x-4">
                            <button type="button" id="clear" class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-4 rounded">Effacer</button>
                            <button type="submit" id="validate" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded">Valider</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# Librairie JS pour capturer et convertir la signature en base64 #}
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script>
    <script>
        const canvas = document.getElementById('signature-pad');
        const signaturePad = new SignaturePad(canvas);

        // Bouton "Effacer" : vide le canvas
        document.getElementById('clear').addEventListener('click', () => {
            signaturePad.clear();
        });

        // Bouton "Valider" : vérifie et encode la signature en base64 dans le champ caché
        document.getElementById('validate').addEventListener('click', (e) => {
            if (signaturePad.isEmpty()) {
                e.preventDefault();
                alert("Veuillez signer avant de valider !");
                return;
            }

            const signatureData = signaturePad.toDataURL(); // <- Ici se fait l'encodage en base64
            document.getElementById('signature').value = signatureData;
        });
    </script>

{% endblock %}
