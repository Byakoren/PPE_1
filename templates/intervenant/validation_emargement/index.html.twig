{% extends 'base.html.twig' %}
{% block header %}
	{% include 'auth/menu.html.twig' %}
{% endblock %}
{% block title %}Hello PlanningIntervenantController!
{% endblock %}

{% block body %}

    {% include 'auth/menu.html.twig' %}

    

    <div class="flex flex-col items-center justify-center min-h-screen bg-gradient-to-br from-[#020024] via-[#1b2a59] to-[#273273] p-2">
        <div class="w-full max-w-screen-xl mt-12 px-5">
            <div class="w-full max-w-[850px] bg-white p-5 rounded-xl shadow-lg text-center mx-auto">
                {#<h2 class="text-2xl font-semibold mb-4 text-[#273273]">Bonjour {{app.user.prenom}} <img class="w-10 inline" src="{{ asset("images/hand-waving-hand.gif") }}" alt="wavinghandgif"></h2>#}
                <table class="" id="liste-Apprenant-Validation" >
                    <caption>
                        Liste des apprenants du cours {{cours.commentaire}}
                    </caption>
                    <thead>
                    <tr>
                        <th scope="col">Nom</th>
                        <th scope="col">Prénom</th>
                        <th scope="col">Validation</th>
                        <th scope="col">Signature</th>

                    </tr>
                    </thead>
                    <tbody>
                        <!--<li class="odd:bg-gray-100 even:bg-white p-2">-->
                        {% for apprenants in liste_apprenants %}
                        <tr>
                        <th scope="row">{{ apprenants.nom }}</th>
                        <td>{{apprenants.prenom}}</td>
                        <td>{{((apprenants.validation == "Non validé") ? "❌ Non validé" : "✅ Validé")}}</td>
                        <td>{{((apprenants.signature == "Non signé") ? "❌ Non signé" : "✅ signé")}}</td>
                        </tr>
                        
                        {% endfor %}
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
  <!--{% for apprenants in liste_apprenants %}
                            <tr>
                                <th scope="row"></th>    
                                <p> {{ apprenants.nom ~ " " ~ apprenants.prenom ~ " " ~ ((apprenants.validation == "Non validé") ? "❌ Non validé" : "✅ Validé") ~ " " ~ ((apprenants.signature == "Non signé") ? "❌ Non signé" : "✅ signé")  }}</p>
                                
                                
                            </tr>    
                        {% endfor %}-->      
{% endblock %}

