{% extends 'base.html.twig' %}
{% block header %}
	{% include 'auth/menu.html.twig' %}
{% endblock %}
{% block title %}Hello PlanningIntervenantController!
{% endblock %}

{% block body %}

    {% include 'auth/menu.html.twig' %}

    

    <div class="flex flex-col items-center justify-center min-h-screen bg-gradient-to-br from-[#020024] via-[#1b2a59] to-[#273273] p-2">
        <div class="w-full max-w-screen-xl mt-12 px-5">
            <div class="w-full max-w-[850px] bg-white p-5 rounded-xl shadow-lg text-center mx-auto">
                {#<h2 class="text-2xl font-semibold mb-4 text-[#273273]">Bonjour {{app.user.prenom}} <img class="w-10 inline" src="{{ asset("images/hand-waving-hand.gif") }}" alt="wavinghandgif"></h2>#}
                <div class="space-y-4">
                    <h3 class="text-xl font-semibold mb-4 text-[#273273]">
                        Liste des apprenants du cours {{ cours.commentaire }}
                    </h3>
                    {% for apprenants in liste_apprenants %}
                        <div class="flex flex-col md:flex-row items-center justify-between bg-gray-100 rounded-lg p-4 shadow mb-2">
                            <div class="flex-1 text-left">
                                <span class="font-bold">{{ apprenants.nom }} {{ apprenants.prenom }}</span>
                            </div>
                            <div class="flex items-center space-x-4 mt-2 md:mt-0">

                                
              
  

                                {#Si l'apprenants a moins de 120 min de retard: affiche si il est validé et si il a signé.#}
                                {% if apprenants.retard <= 120 %}

                                    {#Validé?#}
                                    <span class="px-2 py-1 rounded {{ apprenants.validation == 'Non validé' ? 'bg-red-200 text-red-800' : 'bg-green-200 text-green-800' }}">
                                        {{ apprenants.validation == "Non validé" ? "❌ Non validé" : "✅ Validé" }}
                                    </span>
                                    {% if apprenants.validation == "Non validé" %}
                                    <form method="post" action="{{ path("valider_signature", {id: apprenants.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token("valider_signature" ~ apprenants.id) }}">
                                        <button type="submit" class="px-2 py-1 rounded bg-blue-500 text-white">Valider</button>
                                    </form>
                                    {% else %}
                                    <form method="post" action="{{ path("valider_signature", {id: apprenants.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token("valider_signature" ~ apprenants.id) }}">
                                        <button type="submit" disabled class="px-2 py-1 rounded bg-blue-300 text-white opacity-60 cursor-not-allowed">Valider</button>
                                    </form>

                                    {% endif %}
                                    {#Signé?#}
                                    <span class="px-2 py-1 rounded {{ apprenants.signature == 'Non signé' ? 'bg-red-200 text-red-800' : 'bg-green-200 text-green-800' }}">
                                        {{ apprenants.signature == "Non signé" ? "❌ Non signé" : "✅ signé à " }}
                                        {# ternaire; si apprenants.heureSignature est NULL n'affiche rien(d'ou la chaine vide '') sinon affiche
                                        l'heure. le |date("H:i") est un filtre qui permet de formater la valeur renvoyé sous forme de date en string.#}
                                        {{ apprenants.heureSignature ? apprenants.heureSignature|date('H:i') : '' }}
                                    </span>
                                {#Si l'apprenant a plus de 15 min de retard et n'a pas signé: afficher Absent.#}
                                {% elseif apprenants.retard > 15 and apprenants.signature == 'Non signé'  %}
                                    <span class="px-2 py-1 rounded bg-red-200 text-red-800">
                                        Absent
                                    </span>
                                {#Si l'apprenant  a signé: affiche Absent.#}
                                {% elseif apprenants.retard > 15 and apprenants.signature == 'Signé'  %}
                                    <span class="px-2 py-1 rounded bg-green-200 text-green-800">
                                        Présent
                                    </span>
                                {% endif %}
                                {#Si l'apprenant a signé: affiche Pas de retard.#}
                                {% if apprenants.signature == "Signé" and apprenants.retard == 0 %}
                                    <span class="px-2 py-1 rounded bg-green-200 text-green-800">
                                        Pas de retard
                                    </span>
                                {% else %}
                                    {% if apprenants.retard > 15 %}
                                        <span class="text-red-600 font-semibold"> retard > 15min</span>
                                    {% else %}
                                       <span class="text-red-600 font-semibold">{{ apprenants.retard }} minutes de retard</span> 
                                    {% endif %}

                                {% endif %}
                                {#Optionnel: Pour ajouter un commentaire par élève a l'émargement.#}
                                {#<textarea name="commentaire" rows="2" class="border rounded p-2 w-48" placeholder="Laisser un commentaire...">{{apprenants.commentaire}}</textarea>#}
                            </div>
                        </div>
                    {% else %}
                        <p>Aucun apprenant à afficher.</p>
                    {% endfor %}
                </div>
                
            </div>
        </div>
    </div>
    
  <!--{% for apprenants in liste_apprenants %}
                            <tr>
                                <th scope="row"></th>    
                                <p> {{ apprenants.nom ~ " " ~ apprenants.prenom ~ " " ~ ((apprenants.validation == "Non validé") ? "❌ Non validé" : "✅ Validé") ~ " " ~ ((apprenants.signature == "Non signé") ? "❌ Non signé" : "✅ signé")  }}</p>
                                
                                
                            </tr>    
                        {% endfor %}-->      
{% endblock %}

