{% extends 'base.html.twig' %}

{% block title %}Email de réinitialisation envoyé{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#020024] via-[#1b2a59] to-[#273273]">
    <div class="max-w-lg w-full mx-auto bg-white rounded-2xl shadow-lg p-8 flex flex-col items-center">
        <div class="text-2xl font-semibold mb-5 text-[#273273] text-center">
            Email de réinitialisation envoyé
        </div>
        <p class="text-[#273273] text-base mb-4 text-center">
            Si un compte correspond à votre email, un message vient d’être envoyé avec un lien pour réinitialiser votre mot de passe.<br>
            Ce lien expirera dans <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
        </p>
        <p class="text-gray-600 text-sm text-center">
            Si vous ne recevez pas d’email, vérifiez votre dossier spam ou <a href="{{ path('app_forgot_password_request') }}" class="text-[#ff7f32] underline hover:text-[#e86c1a]">réessayez</a>.
        </p>
    </div>
</div>
{% endblock %}