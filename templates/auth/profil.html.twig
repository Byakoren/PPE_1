{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
    {% include 'auth/menu.html.twig' %}

    <div class="flex justify-center items-center min-h-screen bg-gradient-to-br from-[#020024] via-[#1b2a59] to-[#273273] p-4">
        <div class="bg-white rounded-2xl shadow-lg w-full max-w-3xl p-8">
            <h1 class="text-3xl font-bold text-center text-[#0b1531] mb-6">Mon Profil</h1>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-3 rounded-lg bg-green-100 text-green-800 font-semibold">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                <div class="flex items-center gap-6 mb-8">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-[#F26619] shadow-md">
                        <img id="avatar-preview"
                             src="{{ asset(user.avatar ? 'uploads/avatars/' ~ user.avatar : 'images/photo_profil.png') }}"
                             alt="Avatar"
                             class="w-full h-full object-cover">
                    </div>

                    <div class="flex-1">
                        <label for="{{ form.profileImage.vars.id }}" class="block mb-2 font-semibold text-gray-800">Changer d’avatar :</label>
                        {{ form_widget(form.profileImage, {
                            'attr': {
                                'class': 'block w-full text-sm text-gray-700 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none'
                            }
                        }) }}

                        <button type="submit" class="mt-4 bg-[#F26619] text-white font-semibold px-6 py-2 rounded-lg hover:bg-[#F24C27] transition">
                            Enregistrer l’image
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 mb-8">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Nom :</label>
                        <p class="w-full bg-gray-100 border border-gray-300 rounded px-3 py-2">{{ user.nom }}</p>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Prénom :</label>
                        <p class="w-full bg-gray-100 border border-gray-300 rounded px-3 py-2">{{ user.prenom }}</p>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Email :</label>
                        <p class="w-full bg-gray-100 border border-gray-300 rounded px-3 py-2">{{ user.email }}</p>
                    </div>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[type="file"][name$="[profileImage][file]"]');
            const preview = document.querySelector('#avatar-preview');

            if (input && preview) {
                input.addEventListener('change', (event) => {
                    const file = event.target.files[0];
                    if (file && file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = e => {
                            preview.src = e.target.result;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>

    {% include 'auth/footer.html.twig' %}
{% endblock %}
